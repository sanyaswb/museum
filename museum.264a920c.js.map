            src: 'src/images/gallery/gallery-img-4.jpg',
            alt: 'image painting 4'
        }
    ];
    var renderMobile = function() {
        var slidesHTML = images.map(function(img) {
            return '\n      <div class="swiper-slide">\n        <img class="gallery__image" src="'.concat(img.src, '" alt="').concat(img.alt, '" />\n      </div>\n    ');
        }).join('');
        gallerySection.innerHTML = '\n      <div class="gallery__slider swiper">\n        <div class="swiper-wrapper">\n          '.concat(slidesHTML, '\n        </div>\n      </div>\n      <div class="gallery__pagination swiper-pagination"></div>\n    ');
